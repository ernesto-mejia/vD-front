import { Component, OnInit, OnDestroy } from '@angular/core';
import { CommonModule } from '@angular/common';
import { RouterModule, Router } from '@angular/router';
import { FormBuilder, FormGroup, FormArray, Validators, ReactiveFormsModule, FormsModule } from '@angular/forms';
import { Subject, takeUntil, debounceTime, distinctUntilChanged } from 'rxjs';
import { PurchaseRequestService } from '../purchase-request.service';
import { ProviderService } from '../../../providers/provider.service';
import {
  CreatePurchaseRequestDTO,
  PurchaseRequestItemDTO,
  PRIORITIES,
  ProductSearchItem,
  ContractSummary
} from '../purchase-requests';
import { SidebarComponent } from '../../../sidebar/sidebar.component';
import Swal from 'sweetalert2';

interface Provider {
  id: number;
  name: string;
  rfc: string;
  person_type?: string;
}

interface Item {
  id: number;
  name: string;
  code?: string;
  unit?: string;
  price?: number;
}

interface Address {
  id: number;
  street: string;
  city: string;
  state: string;
}

interface TaxRates {
  iva_rate: number;
  isr_rate: number;
  iva_retention_rate: number;
  isr_retention_rate: number;
  person_type: string;
}

@Component({
  selector: 'app-purchase-request-add',
  standalone: true,
  imports: [CommonModule, RouterModule, ReactiveFormsModule, FormsModule, SidebarComponent],
  templateUrl: './purchase-request-add.component.html',
  styleUrls: ['./purchase-request-add.component.css']
})
export class PurchaseRequestAddComponent implements OnInit, OnDestroy {
  private destroy$ = new Subject<void>();
  private providerSearchSubject = new Subject<string>();
  private itemSearchSubject = new Subject<string>();
  private productSearchSubject = new Subject<string>();

  form!: FormGroup;
  priorities = PRIORITIES;

  // Datos de catálogos
  providers: Provider[] = [];
  items: Item[] = [];
  addresses: Address[] = [];

  // Datos para flujo en dos fases
  contracts: ContractSummary[] = [];
  contractProducts: ProductSearchItem[] = [];
  searchedProducts: ProductSearchItem[] = [];
  isContractRelated = false;

  // Modal de item manual
  showManualItemModal = false;
  manualItemForm!: FormGroup;

  // Estados de carga
  loading = false;
  loadingProviders = false;
  loadingItems = false;
  loadingAddresses = false;
  loadingTaxRates = false;
  loadingContracts = false;
  loadingContractProducts = false;
  loadingProductSearch = false;

  // Búsqueda
  providerSearchTerm = '';
  itemSearchTerm = '';
  productSearchTerm = '';

  // Tasas de impuestos del proveedor
  taxRates: TaxRates | null = null;

  // Totales calculados
  calculatedTotals = {
    subtotal: 0,
    iva: 0,


  constructor(
    private fb: FormBuilder,
    private purchaseRequestService: PurchaseRequestService,
    private router: Router
  ) {}

  ngOnInit(): void {
    this.initForm();
    this.initManualItemForm();
    this.loadUserContracts();
    this.setupSearchSubscriptions();
    this.setupItemCountUpdate();
  }

  ngOnDestroy(): void {
    this.destroy$.next();
    this.destroy$.complete();
  }

  private initForm(): void {
    const today = new Date();
    const requiredDate = new Date(today);
    requiredDate.setDate(requiredDate.getDate() + 7); // Por defecto 7 días después

    this.form = this.fb.group({
      is_contract_related: [false],
      contract_id: [null],
      manual_destination: [''],
      title: ['', Validators.required],
      description: [''],
      priority: ['normal', Validators.required],
      required_date: [this.formatDateForInput(requiredDate), Validators.required],
      notes: [''],
      items: this.fb.array([], [Validators.required, Validators.minLength(1)])
    });

    // Escuchar cambios en is_contract_related
    this.form.get('is_contract_related')?.valueChanges.pipe(
      takeUntil(this.destroy$)
    ).subscribe(value => {
      this.isContractRelated = value;
      this.onContractModeChange();
    });

    // Escuchar cambios en contract_id
    this.form.get('contract_id')?.valueChanges.pipe(
      takeUntil(this.destroy$)
    ).subscribe(contractId => {
      if (contractId) {
        this.loadContractProducts(contractId);
      } else {
        this.contractProducts = [];
      }
    });
  }

  private initManualItemForm(): void {
    this.manualItemForm = this.fb.group({
      item_name: ['', Validators.required],
      item_description: [''],
      quantity: [1, [Validators.required, Validators.min(0.01)]],
      unit_of_measurement: ['pza'],
      suggested_category: [''],
      notes: ['']
    });
  }

  get itemsArray(): FormArray {
    return this.form.get('items') as FormArray;
  }

  private createItemFormGroup(item?: any): FormGroup {
    return this.fb.group({
      item_id: [item?.item_id || null],
      item_name: [item?.item_name || '', Validators.required],
      item_description: [item?.item_description || ''],
      is_manual_item: [item?.is_manual_item || false],
      quantity: [item?.quantity || 1, [Validators.required, Validators.min(0.01)]],
      unit_of_measurement: [item?.unit_of_measurement || 'pza'],
      suggested_category: [item?.suggested_category || ''],
      notes: [item?.notes || '']
    });
  }

  addItem(): void {
    this.itemsArray.push(this.createItemFormGroup());
  }

  addManualItem(): void {
    if (this.manualItemForm.invalid) {
      return;
    }

    const manualItem = this.manualItemForm.value;
    const itemGroup = this.createItemFormGroup({
      item_id: null,
      item_name: manualItem.item_name,
      item_description: manualItem.item_description,
      is_manual_item: true,
      quantity: manualItem.quantity,
      unit_of_measurement: manualItem.unit_of_measurement,
      suggested_category: manualItem.suggested_category,
      notes: manualItem.notes
    });
    
    this.itemsArray.push(itemGroup);
    this.closeManualItemModal();
    this.updateItemCount();

    this.itemsArray.push(itemGroup);
    this.searchedProducts = [];
    this.productSearchTerm = '';
    this.calculateTotals();
  }

  addContractProduct(product: ProductSearchItem): void {
    const itemGroup = this.createItemFormGroup({
      item_id: product.id,
      item_name: product.name,
      item_description: product.description,
      is_manual_item: false,
      quantity: 1,
      unit_of_measurement: product.unit_of_measurement || 'pza'
    });
    
    this.itemsArray.push(itemGroup);
    this.updateItemCount();
      unit_of_measurement: 'pza',
      suggested_category: '',
      notes: ''
    });
    this.showManualItemModal = true;
  }

  closeManualItemModal(): void {
    this.showManualItemModal = false;
  }

  removeItem(index: number): void {
    if (this.itemsArray.length > 0) {
      this.itemsArray.removeAt(index);
      this.updateItemCount();
    }
  }

  // Cargar datos
  loadProviders(search?: string): void {
    this.loadingProviders = true;
    this.providerService.getProviders()
      .pipe(takeUntil(this.destroy$))
      .subscribe({
        next: (response) => {
          // Mapear los proveedores al formato esperado
          this.providers = (response.data || []).map((p: any) => ({
            id: p.id,
            name: p.company || p.name || p.shortname || 'Sin nombre',
            rfc: p.rfc || p.document_number || '',
            person_type: p.person_type
          }));

          // Filtrar por búsqueda si existe
          if (search && search.trim()) {
            const searchLower = search.toLowerCase();
            this.providers = this.providers.filter(p =>
              p.name.toLowerCase().includes(searchLower) ||
              p.rfc.toLowerCase().includes(searchLower)
            );
          }

          this.loadingProviders = false;
        },
        error: (error) => {
          console.error('Error loading providers:', error);
          Swal.fire('Error', 'No se pudieron cargar los proveedores', 'error');
          this.providers = [];
          this.loadingProviders = false;
        }
      });
  }

  loadItems(search?: string): void {
    this.loadingItems = true;
    setTimeout(() => {
      this.loadingItems = false;
    }, 200);
  }

  loadUserContracts(search?: string): void {
    this.loadingContracts = true;
    this.purchaseRequestService.getUserContracts(search)
      .pipe(takeUntil(this.destroy$))
      .subscribe({
        next: (response) => {
          this.contracts = response.data || [];
          this.loadingContracts = false;
        },
        error: (error) => {
          console.error('Error loading contracts:', error);
          this.contracts = [];
          this.loadingContracts = false;
        }
      });
  }

  loadContractProducts(contractId: number): void {
    this.loadingContractProducts = true;
    this.purchaseRequestService.getContractProducts(contractId)
      .pipe(takeUntil(this.destroy$))
      .subscribe({
        next: (response) => {
          this.contractProducts = response.data || [];
          this.loadingContractProducts = false;

          // Si el contrato tiene proveedor, seleccionarlo automáticamente
          const contract = this.contracts.find(c => c.id === contractId);
          if (contract?.provider_id) {
            this.form.patchValue({ provider_id: contract.provider_id });
            this.onProviderChange();
          }
        },
        error: (error) => {
          console.error('Error loading contract products:', error);
          this.contractProducts = [];
          this.loadingContractProducts = false;
        }
      });
  }

  searchProducts(term: string): void {
    if (term.length < 2) {
      this.searchedProducts = [];
      return;
    }

    this.loadingProductSearch = true;
    const providerId = this.form.get('provider_id')?.value;

    this.purchaseRequestService.searchProducts(term, {
      providerId: providerId || undefined,
      limit: 15
    })
      .pipe(takeUntil(this.destroy$))
      .subscribe({
        next: (response) => {
          this.searchedProducts = response.data || [];
          this.loadingProductSearch = false;
        },
        error: (error) => {
          console.error('Error searching products:', error);
          this.searchedProducts = [];
          this.loadingProductSearch = false;
        }
      });
  }

  onContractModeChange(): void {
    if (this.isContractRelated) {
      // Modo contrato: limpiar proveedor manual, se seleccionará del contrato
      this.form.get('manual_destination')?.setValue('');
    } else {
      // Modo interno: limpiar contrato
      this.form.get('contract_id')?.setValue(null);
      this.contractProducts = [];
    }
  }

  loadAddresses(providerId?: number): void {
    if (!providerId) {
      this.addresses = [];
      return;
    }

    this.loadingAddresses = true;
    this.providerService.getProviderAddresses(providerId)
      .pipe(takeUntil(this.destroy$))
      .subscribe({
        next: (addresses) => {
          this.addresses = (addresses || []).map((a: any) => ({
            id: a.id,
            street: a.street || a.address || '',
            city: a.city || a.municipality || '',
            state: a.state || ''
          }));
          this.loadingAddresses = false;
        },
        error: (error) => {
          console.error('Error loading addresses:', error);
          this.addresses = [];
          this.loadingAddresses = false;
        }
      });
  }

  // Configurar búsqueda con debounce
  private setupSearchSubscriptions(): void {
    this.providerSearchSubject.pipe(
      debounceTime(300),
      distinctUntilChanged(),
      takeUntil(this.destroy$)
    ).subscribe(term => {
      this.loadProviders(term);
    });

    this.itemSearchSubject.pipe(
      debounceTime(300),
      distinctUntilChanged(),
      takeUntil(this.destroy$)
    ).subscribe(term => {
      this.loadItems(term);
    });

    this.productSearchSubject.pipe(
      debounceTime(400),
      distinctUntilChanged(),
      takeUntil(this.destroy$)
    ).subscribe(term => {
      this.searchProducts(term);
    });
  }

  onProviderSearch(term: string): void {
    this.providerSearchTerm = term;
    this.providerSearchSubject.next(term);
  }

  onItemSearch(term: string): void {
    this.itemSearchTerm = term;
    this.itemSearchSubject.next(term);
  }

  onProductSearch(term: string): void {
    this.productSearchTerm = term;
    this.productSearchSubject.next(term);
  }

  // Cuando cambia el proveedor, cargar tasas de impuestos y direcciones
  onProviderChange(): void {
    const providerId = this.form.get('provider_id')?.value;
    if (providerId) {
      this.loadTaxRates(providerId);
      this.loadAddresses(providerId);
    } else {
      this.taxRates = null;
      this.addresses = [];
      this.calculateTotals();
    }
  }

  loadTaxRates(providerId: number): void {
    this.loadingTaxRates = true;
    this.purchaseRequestService.getProviderTaxRates(providerId).pipe(
      takeUntil(this.destroy$)
    ).subscribe({
      next: (response) => {
        this.taxRates = response.data;
        this.calculateTotals();
        this.loadingTaxRates = false;
      },
      error: () => {
        this.taxRates = null;
        this.loadingTaxRates = false;
      }
    });
  }

  // Configurar cálculos automáticos
  private setupCalculations(): void {
    this.itemsArray.valueChanges.pipe(
      takeUntil(this.destroy$)
    ).subscribe(() => {
      this.calculateTotals();
    });
  }

  calculateTotals(): void {
    const items = this.itemsArray.value;
    let subtotal = 0;

    items.forEach((item: any) => {
      const qty = parseFloat(item.quantity) || 0;
      const price = parseFloat(item.unit_price) || 0;
      subtotal += qty * price;
    });

    this.calculatedTotals.subtotal = subtotal;

    if (this.taxRates) {
      this.calculatedTotals.iva = subtotal * (this.taxRates.iva_rate / 100);
      this.calculatedTotals.isr = subtotal * (this.taxRates.isr_rate / 100);
      this.calculatedTotals.iva_retention = subtotal * (this.taxRates.iva_retention_rate / 100);
      this.calculatedTotals.isr_retention = subtotal * (this.taxRates.isr_retention_rate / 100);
    } else {
      // Sin proveedor, solo IVA 16%
      this.calculatedTotals.iva = subtotal * 0.16;
      this.calculatedTotals.isr = 0;
      this.calculatedTotals.iva_retention = 0;
      this.calculatedTotals.isr_retention = 0;
    }

    this.calculatedTotals.total =
      subtotal
      + this.calculatedTotals.iva
      + this.calculatedTotals.isr
      - this.calculatedTotals.iva_retention
      - this.calculatedTotals.isr_retention;
  }

  // Seleccionar item del catálogo
  selectItem(index: number, item: Item): void {
    const itemGroup = this.itemsArray.at(index) as FormGroup;
    itemGroup.patchValue({
      item_id: item.id,
      item_name: item.name,
      unit: item.unit || 'pza',
      unit_price: item.price || 0
    });
    this.calculateTotals();
  }

  // Calcular total de un item
  getItemTotal(index: number): number {
    const item = this.itemsArray.at(index);
    const qty = parseFloat(item.get('quantity')?.value) || 0;
    const price = parseFloat(item.get('unit_price')?.value) || 0;
    return qty * price;
  }

  // Guardar
  async save(submitAfterSave = false): Promise<void> {
    if (this.form.invalid) {
      this.markFormGroupTouched();
      Swal.fire('Error', 'Por favor complete todos los campos requeridos', 'error');
      return;
    }

    if (this.itemsArray.length === 0) {
      Swal.fire('Error', 'Debe agregar al menos un artículo', 'error');
      return;
    }

    // Validar que cada item tenga nombre
    const itemsWithoutName = this.itemsArray.controls.filter(
      (item) => !item.get('item_name')?.value?.trim()
    );
    if (itemsWithoutName.length > 0) {
      Swal.fire('Error', 'Todos los artículos deben tener un nombre', 'error');
      return;
    }

    this.loading = true;

    const formValue = this.form.value;
    const today = new Date().toISOString().split('T')[0];
    const dto: CreatePurchaseRequestDTO = {
      provider_id: formValue.provider_id || undefined,
      contract_id: formValue.contract_id || undefined,
      is_contract_related: formValue.is_contract_related,
      delivery_address_id: formValue.delivery_address_id || undefined,
      manual_destination: formValue.manual_destination || undefined,
      title: formValue.description, // Usar descripción como título
      description: formValue.description,
      request_date: today,
      priority: formValue.priority,
      required_date: formValue.required_date,
      notes: formValue.notes || undefined,
      items: formValue.items.map((item: any) => ({
        item_id: item.item_id || undefined,
        item_name: item.item_name,
        item_description: item.item_description,
        is_manual_item: item.is_manual_item || !item.item_id,
        quantity: item.quantity,
        unit: item.unit || item.unit_of_measurement,
        unit_of_measurement: item.unit_of_measurement || item.unit,
        unit_price: item.unit_price || 0,
        suggested_category: item.suggested_category || undefined,
        notes: item.notes || undefined
      }))
    };

    this.purchaseRequestService.create(dto).pipe(
      takeUntil(this.destroy$)
    ).subscribe({
      next: (response) => {
        this.loading = false;

        if (submitAfterSave && response.data) {
          this.submitRequest(response.data.id);
        } else {
          Swal.fire('Éxito', 'Solicitud de compra creada correctamente. Está en estado borrador.', 'success');
          this.router.navigate(['/purchases/purchase-requests']);
        }
      },
      error: (err) => {
        this.loading = false;
        const message = err.error?.message || 'Error al crear la solicitud';
        Swal.fire('Error', message, 'error');
      }
    });
  }

  private submitRequest(id: number): void {
    this.purchaseRequestService.submit(id).subscribe({
      next: () => {
        Swal.fire('Éxito', 'Solicitud creada y enviada para pre-autorización', 'success');
        this.router.navigate(['/purchases/purchase-requests']);
      },
      error: () => {
        Swal.fire('Aviso', 'Solicitud creada pero no se pudo enviar automáticamente. Puede enviarla desde el listado.', 'warning');
        this.router.navigate(['/purchases/purchase-requests']);
      }
    });
  }

  cancel(): void {
    this.router.navigate(['/purchases/purchase-requests']);
  }

  // Utilidades
  private markFormGroupTouched(): void {
    Object.keys(this.form.controls).forEach(key => {
      const control = this.form.get(key);
      control?.markAsTouched();

      if (control instanceof FormArray) {
        control.controls.forEach(c => {
          if (c instanceof FormGroup) {
            Object.keys(c.controls).forEach(k => c.get(k)?.markAsTouched());
          }
        });
      }
    });
  }

  private formatDateForInput(date: Date): string {
    return date.toISOString().split('T')[0];
  }

  formatCurrency(value: number): string {
    return this.purchaseRequestService.formatCurrency(value);
  }

  isFieldInvalid(fieldName: string): boolean {
    const field = this.form.get(fieldName);
    return field ? field.invalid && field.touched : false;
  }

  isItemFieldInvalid(index: number, fieldName: string): boolean {
    const item = this.itemsArray.at(index);
    const field = item?.get(fieldName);
    return field ? field.invalid && field.touched : false;
  }

  getPersonTypeLabel(): string {
    if (!this.taxRates) return '';
    return this.taxRates.person_type === 'moral' ? 'Persona Moral' : 'Persona Física';
  }
}
